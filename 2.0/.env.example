# IV Crush — environment template.
#
# Copy to 2.0/.env and fill in. This is the ONLY .env in the repo.
#
# Source it with `set -a && source 2.0/.env && set +a`. Plain `source` sets
# shell variables without exporting them, so Python subprocesses see nothing.
#
# ⚠️ Editing .env in place leaves a plaintext .env.bak_* beside it — a full
# copy of every credential, in the clear. Shred it, don't `rm` it.
#
# ⚠️ Do NOT load this file with systemd `EnvironmentFile=`. It does not strip
# trailing inline comments, so KELLY_FRACTION would become the literal string
# "0.25  # 25% of full Kelly". The units source it through bash instead.
#
# Only the values in "Required" have no default. Everything else is a
# documented override of a default that already lives in src/config/config.py
# (or common/constants.py) — that file, not this one, is authoritative.

# ============================================================================
# Required
# ============================================================================

# Options chains, quotes, IV, term structure. Primary data source.
TRADIER_API_KEY=

# Earnings calendar (primary). Free tier: 60 calls/min, 30k/month.
FINNHUB_API_KEY=

# Postgres 18.6 on the server — the database. No path is passed anywhere; every
# entry point reads these. A wrong DSN fails to connect rather than silently
# creating an empty database, which the old SQLite DB_PATH did.
PGHOST=db.internal
PGPORT=5432
PGDATABASE=ivcrush
PGUSER=trading
PGPASSWORD=

# ============================================================================
# Optional data sources
# ============================================================================

# Historical price backfills (scripts/backfill_historical.py). 800 calls/day.
TWELVE_DATA_KEY=

# AI sentiment (/collect, /council).
PERPLEXITY_API_KEY=

# ============================================================================
# Notifications — absent means skipped, never an error
# ============================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Uptime Kuma push monitor for the morning digest. the server only.
# ⚠️ QUOTE the value — it contains `&`, which an unquoted source splits on.
# MORNING_DIGEST_PUSH_URL="https://..."

# ============================================================================
# ORATS — dead subscription, kept for the resubscription case
# ============================================================================

# Ended Jun 2026; key dead Jul 2 2026. When false, ORATS calls are skipped and
# the fused skew bias is the Tradier reading alone (single source).
# The position_limits ORATS snapshot is frozen at 2026-06-24 — never size off
# it, and never set this back to true expecting live data. Only "true" turns it
# on; unset is off (APIConfig.orats_enabled, since 2026-09-14 — it used to be on).
ORATS_ENABLED=false
# ORATS_API_KEY=

# ============================================================================
# Position sizing — the knobs that actually move live sizing
# ============================================================================

# Risk budget of a fixed dollar-risk rule (NOT Kelly, despite the names), NOT a loss cap:
#   base_contracts = RISK_BUDGET_PER_TRADE / max_loss_per_spread
# then x KELLY_FRACTION x POP/EV quality. Largest single input to sizing (CLAUDE.md §6).
# At KELLY_FRACTION 0.25 it targets $62,500 of max loss, so MAX_LOSS_WARN_THRESHOLD
# below is what binds a wide spread.
RISK_BUDGET_PER_TRADE=250000

USE_KELLY_SIZING=true
KELLY_FRACTION=0.25
KELLY_MIN_CONTRACTS=1

# Sizing tiers. These reach the live path via SizingContext.from_strategy_config().
SIZING_BASE_CAP=100           # maximum ever, whatever the conviction (a ceiling)
SIZING_DEFAULT_CAP=50         # cap when no sizing flag fires (CLAUDE.md rule 4)
SIZING_TRR_HIGH_CAP=50        # TRR HIGH hard cap
SIZING_COMPOUND_RISK_CAP=25   # compound tail-risk floor
SIZING_REDUCTION_FACTOR=0.5   # one 50% cut each for MARGINAL VRP / WARNING liquidity

# ⚠️ MAX_CONTRACTS binds ONLY on the fallback path where no SizingContext is
# passed. It looks authoritative and is not — SIZING_BASE_CAP is the knob that
# moves live sizing. Set to 100 so the two paths agree.
#
# It is also not a risk cap. "50 contracts x $500 = $25K" only holds for a
# $5-wide spread with no credit; a high-priced single was 110 contracts at ~$3,090
# each, ~$340k of risk while reading as compliant. Size on max loss.
MAX_CONTRACTS=100

# Worst-case max loss per position, priced at natural (sell at bid, buy at ask).
# The engine sizes every structure within it -- the spreads, the calendar pilot,
# the scan's liquidity bar -- and /analyze warns above it (a one-contract spread
# can still exceed it). It blocks nothing sized by hand. 0 disables both.
MAX_LOSS_WARN_THRESHOLD=50000

# ============================================================================
# Thresholds and algorithm toggles
# ============================================================================

# VRP tiers (close-to-close; see CLAUDE.md §1) are not configurable: 2.0/src/domain/vrp_tier.py.

# Fewer than this many quarters of history -> UNKNOWN, not a silent LOW tier.
MIN_HISTORICAL_QUARTERS=4
# MAX_HISTORICAL_QUARTERS=12

# Minimum days to expiration at entry (CLAUDE.md §5: same win rate at 0-2 DTE,
# larger losses). Enforced by calculate_expiration_date on sequential and
# parallel scans alike, and on --expiration-offset.
# MIN_DTE=3

REQUIRE_WEEKLY_OPTIONS=false
USE_INTERPOLATED_MOVE=true
# USE_ENHANCED_SKEW=true
# USE_ENHANCED_CONSISTENCY=true

# Short/long strike deltas for generated spreads.
# TARGET_DELTA_SHORT=0.25
# TARGET_DELTA_LONG=0.20
# SPREAD_WIDTH_HIGH_PRICE=5.0     # stocks >= $20
# SPREAD_WIDTH_LOW_PRICE=3.0      # stocks <  $20
# MIN_CREDIT_PER_SPREAD=0.20
# MIN_REWARD_RISK=0.25
# COMMISSION_PER_CONTRACT=0.65

# ============================================================================
# Rate limiting, cache, logging
# ============================================================================

# ⚠️ All Tradier calls share ONE sliding-window limiter (120 in any 60 s) that waits
# up to 120 s at the HTTP call site. Do not add a second throttle layer — a per-ticker gate stacked on
# this bucket once caused silent ticker drops under load.
# TRADIER_PER_MINUTE=120
# FINNHUB_PER_MINUTE=60
# Twelve Data's free plan allows 800 calls a UTC day per key. Every process on this host
# counts its calls in one file, and past the ceiling every Twelve Data call is refused
# until 00:00 UTC (record_moves' own --budget, 700, still stops the job first).
# TWELVE_DATA_DAILY_CEILING=780
# TWELVE_DATA_USAGE_FILE=~/.local/state/trading-desk/twelve_data_calls

# L1 is in-process memory; L2 is the shared Postgres whisper_cache table.
# CACHE_L1_TTL is only the default for a MemoryCache entry stored without its own
# TTL: Tradier quotes, chains and expirations keep 30 s / 60 s / 1 h whatever it is
# (memory_cache.py PRICE_/CHAIN_/EXPIRATIONS_TTL_SECONDS).
# CACHE_L1_TTL=30
# CACHE_L2_TTL=300
# CACHE_ENABLED=true

# LOG_LEVEL=INFO
# LOG_CONSOLE=true
# LOG_FILE=
