      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ivcrush"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ivcrush"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT job_name,\n       (CURRENT_DATE - MAX(date)) AS days_since_success\nFROM job_status\nWHERE status = 'success'\nGROUP BY job_name;",
          "editorMode": "code"
