    {
      "id": 3,
      "title": "Job failures",
      "type": "stat",
      "description": "Total 'error' rows in job_status.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ivcrush"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ivcrush"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- Scoped to 30 days. Unbounded this read 0 on 2026-09-17, so it was not red --\n-- but it had no date scope at all, meaning the FIRST error ever recorded would\n-- have turned it red permanently with no path back to green. That is the \"a\n-- monitor that is always red is decoration\" failure mode, latent rather than\n-- live. A window makes it an alert again.\nSELECT COUNT(*) AS failures\nFROM job_status\nWHERE status = 'error'\n  AND date >= CURRENT_DATE - 30;",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failures"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Failures (30d)"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
