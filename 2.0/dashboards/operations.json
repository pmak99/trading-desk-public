  "panels": [
    {
      "id": 1,
      "title": "Last run per job",
      "type": "table",
      "description": "Red on error; amber on a 'running' row older than 1h (runner.py's own stale-claim threshold). Colored via the health column, not a numeric threshold on status/days_ago directly -- staleness depends on both fields jointly, which a single-field threshold cannot express.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ivcrush"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ivcrush"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- health mirrors runner.py's own claim logic (STALE_RUNNING_AFTER_SEC=3600):\n-- a 'running' row is only suspect past that age, matching what runner.py\n-- itself treats as a dead claim it will reclaim. Computed here, not left to\n-- Grafana threshold config, because \"stale\" depends on TWO fields jointly\n-- (status AND age) -- a single-field numeric threshold can't express that,\n-- but a single categorical column can be colored by value mapping.\n-- updated_at is displayed via substr, never strftime: job_status.updated_at\n-- carries a timezone offset (e.g. -04:00), and strftime re-parses that as\n-- UTC-relative, silently shifting the displayed time (verified: 08:00 ET\n-- rendered as 12:00). substr truncates the string without reinterpreting it,\n-- so the original ET wall-clock value displays correctly. The health CASE\n-- below still reads the RAW updated_at, not the truncated display column --\n-- only the shown value is shortened, the staleness math needs full precision.\nSELECT job_name, status,\n       to_char(updated_at AT TIME ZONE 'America/New_York',\n               'YYYY-MM-DD HH24:MI') AS updated_at,\n       (CURRENT_DATE - date) AS days_ago,\n       CASE WHEN status = 'error' THEN 'ERROR'\n            WHEN status = 'running'\n             AND now() - updated_at > interval '1 hour'\n            THEN 'STALE'\n            ELSE 'OK' END AS health\nFROM job_status\nWHERE (job_name, date) IN (SELECT job_name, MAX(date) FROM job_status GROUP BY job_name)\nORDER BY job_name;",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "health"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ERROR": {
                        "color": "red",
                        "index": 0
                      },
                      "STALE": {
                        "color": "orange",
                        "index": 1
                      },
                      "OK": {
                        "color": "green",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "job_name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Job"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "updated_at"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Updated"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "days_ago"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Days ago"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "health"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Health"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "job_name"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "updated_at"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "days_ago"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
