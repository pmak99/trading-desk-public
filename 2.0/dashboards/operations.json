    {
      "id": 5,
      "title": "Move-history coverage",
      "type": "table",
      "description": "Tickers by the age of their newest recorded earnings move \u2014 the history every VRP and TRR runs on. A distribution, not a threshold: the staleness rule lives in common/constants.py, and restating it here would duplicate it. 2026-09-17: 898 / 113 / 341 across the first three bands.",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ivcrush"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ivcrush"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- Replaces a row count of three of sixteen tables, which answered a question\n-- Kuma monitors 44/45 (can a client reach the database) and ops_last_run_per_job\n-- (did the job run) already answer better.\n-- This answers one nothing else on any dashboard does: how stale is the move\n-- history that every VRP and TRR is computed from. On 2026-09-16, 488 of 984\n-- tickers with >=4 quarters were stale.\n-- A DISTRIBUTION, not a threshold: QUARTER_GAP_DAYS lives in\n-- common/constants.py, and restating 150 here would be the same duplication as\n-- a VRP or TRR ladder in SQL. The reader sees the shape and judges.\n-- The numeric prefix is the sort key -- plain text ordering put '181-365d'\n-- before '91-180d'.\nSELECT CASE WHEN age <= 90 THEN '1. 0-90d'\n            WHEN age <= 180 THEN '2. 91-180d'\n            WHEN age <= 365 THEN '3. 181-365d'\n            ELSE '4. over 365d' END AS newest_move_age,\n       COUNT(*) AS tickers\nFROM (\n  SELECT ticker, CURRENT_DATE - MAX(earnings_date) AS age\n  FROM historical_moves\n  GROUP BY ticker\n) x\nGROUP BY newest_move_age\nORDER BY newest_move_age;",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "newest_move_age"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Newest move"
              }
            ]
