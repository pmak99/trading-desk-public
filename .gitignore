# Environment variables - NEVER COMMIT API KEYS
.env
.env.backup*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# Claude Code
.claude/settings.json
.claude/settings.local.json

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git worktrees. .claude/worktrees/ is where `remote-control --spawn=worktree`
# puts them, so without it every session leaves the main checkout's git status
# dirty with its own worktree.
.worktrees/
.claude/worktrees/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Data and logs (root level only - legacy cleanup)
/data/
/logs/
*.log
*.csv
!tests/**/fixtures/*.csv

# Legacy directories (removed in cleanup)
/src/
/profiling/
/benchmarks/

# Cache files (persistent API cache)
src/data/cache/

# Profiling results in version directories
1.0/profiling/results/*.prof
1.0/profiling/results/*.txt
1.0/benchmarks/results/*.json
2.0/profiling/results/*.prof
2.0/profiling/results/*.txt
2.0/benchmarks/results/*.json

# /export-report output (scripts/export_scan_results.py and the command's CSV
# exports): 2.0/docs/scan_exports/, or docs/scan_exports/ when run from the root
scan_exports/

# Data directories in version directories (test databases, etc.)
# No trailing slash on 2.0/data: in a worktree it is a SYMLINK to the main
# checkout's directory (the worktree bootstrap script), and a trailing
# slash matches directories only -- the symlink showed up as untracked.
1.0/data/
2.0/data
4.0/data/
5.0/data/
*.db

# Database files - catch-all pattern (prevent ivcrush.db from any directory)
**/ivcrush.db
**/ivcrush.db-journal
**/ivcrush.db-wal

# Jupyter
.ipynb_checkpoints

# mypy, ruff, import-linter
.import_linter_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
3.0/.env

# Backup files
*.backup-*
*.bak

# Exclude sensitive 2025 trade statements and analysis
docs/2025 Trades/
.worktrees/
